PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-frontend.vercel.app
JWT_SECRET=your-secure-jwt-secret-at-least-32-chars

# 32-byte (64 hex characters) AES-256-GCM Encryption Key
ENCRYPTION_KEY=c3f190a6e4d29381c0ab5827e892ef61203498ab5671239845cdfa1234567890

DATABASE_URL="postgresql://username:password@host/neondb?sslmode=require"

# GitHub OAuth Credentials
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_CALLBACK_URL="https://your-backend.onrender.com/api/auth/github/callback"

# Google OAuth Credentials
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="https://your-backend.onrender.com/api/auth/google/callback"

# Gemini AI API Key
GEMINI_API_KEY="your_gemini_api_key"

# Strict Whitelist
ALLOWED_GITHUB_USERS="alokchoudhary885-coder"
